# Sunucuda deploy/install.sh bu değerleri /etc/pingtesti-socket.env içine otomatik yazar.
# Yerel geliştirme için: cp .env.example .env

PORT=8080
HOST=127.0.0.1
SERVER_NAME=local

# coturn "static-auth-secret" ile aynı olmalı. Boşsa TURN kullanılmaz (istemci doğrudan bağlanır).
TURN_SECRET=
# Alternatif: coturn'da sabit kullanıcı (turnserver.conf → user=ad:şifre). TURN_SECRET boşsa kullanılır.
TURN_USERNAME=
TURN_PASSWORD=
# TURN adresi — genel IP önerilir (Cloudflare proxy'li alan adı UDP taşımaz)
TURN_HOST=
TURN_PORT=3478
# relay: tüm trafik bu sunucunun TURN'ünden geçer (tutarlı ölçüm). all: doğrudan bağlantıya da izin ver.
ICE_POLICY=all

# İzinli site kökenleri (virgülle). Boşsa herkes bağlanabilir.
ALLOWED_ORIGINS=https://www.pingtesti.com,https://pingtesti.com
# nginx arkasında 1 (X-Real-IP güvenilir)
TRUST_PROXY=0
MAX_CONN_PER_IP=10
LOG_LEVEL=info
